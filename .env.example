# Copy to .env.local for local dev. Set the same keys in Vercel → Project → Settings → Environment Variables.

# USE_LOCAL_FALLBACK=true — mock catalog only, no agent credits (recommended for local UI work)
# Omit or false on Vercel production for live agent + web search + catalog tools
# USE_LOCAL_FALLBACK=true

# Live agent when USE_LOCAL_FALLBACK is not true
ANTHROPIC_API_KEY=

# Friends beta gate (set before sharing the URL)
BETA_ACCESS_TOKEN=

# Profile storage — add when onboarding ships (Vercel KV or Neon)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# DATABASE_URL=
