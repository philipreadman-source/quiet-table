# Copy to .env.local for local dev. Set the same keys in Vercel → Project → Settings → Environment Variables.
#
# The site has no sign-in, so anyone can reach the agent route. It runs the
# free catalog fallback unless the live agent is switched on on purpose.

# Agent mode (see src/app/api/agent/route.ts)
# Default everywhere: catalog fallback (fallback: true) — no Anthropic spend.
# To run live Claude: USE_LIVE_AGENT=true (and ANTHROPIC_API_KEY).
# USE_LIVE_AGENT=true
# USE_LOCAL_FALLBACK=true

ANTHROPIC_API_KEY=

# Supabase, public values only (the same ones the iOS app ships): the site
# reads anonymous reviews and scores through supabase/web_public.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Apple Maps in the restaurant panel (MapKit JS). Create a token in Apple
# Developer → Certificates, IDs & Profiles → Keys → MapKit JS, limited to the
# site's domains. Without it the panel shows the address and an Apple Maps link.
NEXT_PUBLIC_MAPKIT_TOKEN=

# The web's daily AI budget (supabase/web_ai_budget.sql): €1 a day and 3
# answers per device, then Find answers from the catalog. Server only: get the
# value with `select value from public.web_ai_settings where key = 'secret';`
WEB_AI_BUDGET_SECRET=
# The live agent's model. Haiku keeps answers to about 2 cents each.
# AGENT_MODEL=claude-haiku-5-5
