# Copy to .env.local for local dev. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Clerk (https://dashboard.clerk.com) — required for sign-in
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# After sign-out (optional; also set via ClerkProvider afterSignOutUrl in layout)
# NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in

# Agent mode (see src/app/api/agent/route.ts)
# Production on Vercel defaults to catalog fallback (fallback: true) — no Anthropic spend.
# To run live Claude on production: USE_LIVE_AGENT=true (and ANTHROPIC_API_KEY).
# Local UI work: USE_LOCAL_FALLBACK=true
# USE_LOCAL_FALLBACK=true
# USE_LIVE_AGENT=true

ANTHROPIC_API_KEY=

# Friends beta gate (set before sharing the URL)
BETA_ACCESS_TOKEN=

# Profile storage — Upstash Redis via Vercel Marketplace (free tier for friends beta)
# Vercel auto-injects these when you add the Upstash integration:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Legacy alias names also supported:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
